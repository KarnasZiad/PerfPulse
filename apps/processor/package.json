{
  "name": "@perfpulse/processor",
  "version": "0.1.0",
  "private": true,
  "description": "Stream consumers: batches from Redis to TimescaleDB and MongoDB; schema migrations and project CLI",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@perfpulse/source --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx --conditions=@perfpulse/source --env-file-if-exists=.env src/cli/migrate.ts",
    "project:create": "tsx --conditions=@perfpulse/source --env-file-if-exists=.env src/cli/create-project.ts"
  },
  "dependencies": {
    "@perfpulse/protocol": "workspace:*",
    "ioredis": "^5.11.1",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
