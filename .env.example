# Secrets of the local stack (docker compose --profile app up) and of the services run with pnpm dev.
# Copy to .env, never commit it. Generate each value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

# Digests the read tokens: the CLI that creates them and the API must share it.
API_TOKEN_PEPPER=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
# Signs the session cookie of the dashboard.
SESSION_SECRET=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64

# For pnpm dev, against docker compose up:
DATABASE_URL=postgresql://perfpulse:perfpulse@localhost:5432/perfpulse
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379
COOKIE_SECURE=false
