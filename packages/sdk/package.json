{
  "name": "@perfpulse/sdk",
  "version": "0.1.0",
  "description": "Real user monitoring SDK: Web Vitals and JavaScript errors, under 5 KB, no dependency",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/perfpulse.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "size": "node scripts/build.mjs --size",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@perfpulse/protocol": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.12"
  }
}
